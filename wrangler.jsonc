
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ourpdf",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
